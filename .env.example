# Slack — in production this is the same shared app as Tempus/Munus/Legion.
# Bot scopes needed: chat:write, im:write. The signing secret verifies inbound requests.
SLACK_BOT_TOKEN=xoxb-your-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here
# Where a redemption ping goes so staff know to hand over merch (channel ID like
# C0ABCDE123; blank = off). Invite the bot to it first.
SLACK_ANNOUNCE_CHANNEL=

# ── Legion SSO + roster ──────────────────────────────────────────────────────
# /admin and the /me, /store, /orders portal pages are gated by Legion's shared `mw_sso`
# cookie. /admin needs the `merces-admin` (full) or `merces-manager` (grant/store/orders,
# no adjustments/settings/backup) group; the portal is open to any active roster member.
# There is no local admin password — grant the first admin `merces-admin` in Legion's
# /admin/groups. SSO_SECRET must be identical to Legion's; add merces.marswars.org to
# Legion's SSO_ALLOWED_RETURN_HOSTS or the return_to redirect back to Merces is rejected.
SSO_SECRET=must-match-legion-sso-secret
SSO_SESSION_TTL=43200
SSO_COOKIE_DOMAIN=

# Legion roster API (read-only source of truth) + the one-tap SSO challenge endpoint.
# Must match the value Legion has configured as its MERCES_API_KEY.
LEGION_BASE_URL=https://legion.example.org
LEGION_API_KEY=must-match-legions-merces-api-key

# Database
DATABASE_URL=sqlite+aiosqlite:///./merces.db

# Localisation
TIMEZONE=America/New_York

# Public base URL used in Slack messages that link back to Merces.
# Production: https://merces.marswars.org
BASE_URL=http://localhost:8004

# Display label for the virtual currency awarded to students.
CURRENCY_NAME=MARS Moola

# Store item photo uploads. Deliberately under data/ (persisted volume), not static/
# (baked into the image and wiped on every deploy) — see apps-infra/docker-compose.yml.
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=5

# Database backups (SQLite only)
BACKUP_DIR=backups
BACKUP_KEEP=14
BACKUP_TIME=23:30
BACKUP_DAY=sun

# Master switch for automated Slack messages and scheduled jobs
UPDATES_ENABLED=true

# Dev / preview sign-in shim. Leave BLANK in production. When set, mounts `/dev-login`,
# which mints an `mw_sso` cookie for this host (needed only where Legion's real
# `.marswars.org` cookie can't reach). Every request must pass this exact value:
#   /dev-login?key=<this>&code=<member_code>&groups=merces-admin
DEV_LOGIN_SECRET=
